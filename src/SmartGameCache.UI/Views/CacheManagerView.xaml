<UserControl x:Class="SmartGameCache.UI.Views.CacheManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartGameCache.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">

            <!-- Page Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Cache Manager &amp; Storage Configuration" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="Configure persistent SSD acceleration capacity and RAM prefetch budgets" FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Status Feedback if any -->
            <Border Background="#1E2333" BorderBrush="{StaticResource Brush.Accent.Blue}" BorderThickness="1" 
                    CornerRadius="8" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource Brush.Accent.Blue}"/>
            </Border>

            <!-- SECTION A: RAM PREFETCH BUDGET SLIDER -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RAM PREFETCH BUDGET" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Blue}"/>
                            <TextBlock Text="Warms Windows Cache Manager standby pages before game launch without duplicating memory pools" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Live Slider Value Badge -->
                        <Border HorizontalAlignment="Right" Background="#1D2436" BorderBrush="{StaticResource Brush.Accent.Blue}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding RamBudgetFormatted}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Blue}"/>
                        </Border>
                    </Grid>

                    <!-- Slider -->
                    <Slider Minimum="0.5" Maximum="8.0" SmallChange="0.5" LargeChange="1.0"
                            Value="{Binding RamBudgetGb, Mode=TwoWay}" Style="{StaticResource Style.Slider.Modern}" Margin="0,4,0,12"/>

                    <!-- Sliders Tick Marks Labels -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="512 MB" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Left"/>
                        <TextBlock Text="2.0 GB (Default)" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="-120,0,0,0"/>
                        <TextBlock Text="4.0 GB" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Center" Margin="80,0,0,0"/>
                        <TextBlock Text="8.0 GB (Max Budget)" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Real-Time Memory Telemetry Grid -->
                    <Grid Background="#131620" Margin="0,0,0,0">
                        <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="OS Physical Memory Status" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding SystemMemorySummary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,2"/>
                                    <TextBlock Text="Dynamic memory pressure check active (GlobalMemoryStatusEx)" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Application Private Working Set" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding AppMemorySummary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Green}" Margin="0,4,0,2"/>
                                    <TextBlock Text="Zero memory leakage: all large cache data resides in OS standby pages" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION B: PERSISTENT SSD CACHE SLIDER -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PERSISTENT SSD CACHE CAPACITY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Green}"/>
                            <TextBlock Text="Persistent NVMe/SATA SSD cache directory that survives application and Windows restarts" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Live Slider Value Badge -->
                        <Border HorizontalAlignment="Right" Background="#142621" BorderBrush="{StaticResource Brush.Accent.Green}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding SsdCapacityFormatted}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Green}"/>
                        </Border>
                    </Grid>

                    <!-- Slider -->
                    <Slider Minimum="5.0" Maximum="100.0" SmallChange="5.0" LargeChange="10.0"
                            Value="{Binding SsdCapacityGb, Mode=TwoWay}" Style="{StaticResource Style.Slider.Modern}" Margin="0,4,0,12"/>

                    <!-- Sliders Tick Marks Labels -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="5 GB" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Left"/>
                        <TextBlock Text="30 GB (Default)" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="-60,0,0,0"/>
                        <TextBlock Text="50 GB" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Center" Margin="60,0,0,0"/>
                        <TextBlock Text="100 GB" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Cache Directory & Drive Path -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="SSD Cache Directory Location" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SsdCacheDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Modern}"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Open Folder" Style="{StaticResource Style.Button.Secondary}" Command="{Binding OpenCacheFolderCommand}"/>
                    </Grid>

                    <!-- Storage Quota Details & Cleanup Button -->
                    <Border Background="#131620" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Cache Utilization" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                <TextBlock Text="{Binding CurrentSsdUsageBytes, Converter={StaticResource BytesConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding CachedFilesCount, StringFormat='{}{0} files cached on SSD'}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Available SSD Space on Drive" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                <TextBlock Text="{Binding AvailableSsdSpaceBytes, Converter={StaticResource BytesConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Blue}" Margin="0,4,0,0"/>
                                <TextBlock Text="Verified NTFS Volume" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" VerticalAlignment="Center" Content="Enforce Quota &amp; Evict" Style="{StaticResource Style.Button.Secondary}" Command="{Binding CleanEvictedCacheCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION C: DETECTED SYSTEM DRIVES -->
            <Border Style="{StaticResource Style.Card}">
                <StackPanel>
                    <TextBlock Text="DETECTED STORAGE VOLUMES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding AvailableDrives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DriveLetter}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                        
                                        <Border Grid.Column="2" Background="{Binding MediaType, Converter={StaticResource StorageBadgeConverter}}" 
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaType}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding FileSystemName}" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FreeSizeBytes, Converter={StaticResource BytesConverter}, StringFormat='{}{0} free'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TotalSizeBytes, Converter={StaticResource BytesConverter}, StringFormat='{}of {0}'}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

