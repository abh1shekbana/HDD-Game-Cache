<UserControl x:Class="SmartGameCache.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartGameCache.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">

            <!-- App Title Card -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding AppTitle}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding Tagline}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Blue}" Margin="0,4,0,14"/>
                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>

                    <Grid Background="#131620">
                        <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Version" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Target Framework" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding TargetFramework}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Architecture" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding Architecture}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Architecture Roadmap Card -->
            <Border Style="{StaticResource Style.Card}">
                <StackPanel>
                    <TextBlock Text="TRANSPARENT FILESYSTEM MINIFILTER ROADMAP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Green}" Margin="0,0,0,8"/>
                    <TextBlock Text="The current version operates predictive SSD caching with Windows Cache Manager standby page pre-warming. Milestone 7 introduces an optional Windows Filesystem Minifilter driver for transparent real-time IRP interception, routing verified game reads directly to SSD cache while guaranteeing safe, immediate mechanical HDD fallback."
                               FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

