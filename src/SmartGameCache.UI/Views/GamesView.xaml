<UserControl x:Class="SmartGameCache.UI.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartGameCache.UI.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Game List & Actions -->
        <Border Grid.Column="0" Style="{StaticResource Style.Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <TextBox Grid.Row="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource Style.TextBox.Modern}" Margin="0,0,0,10"/>

                <!-- Action Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="+ Add Game" Style="{StaticResource Style.Button.Secondary}" Command="{Binding AddGameCommand}"/>
                    <Button Grid.Column="2" Content="↻ Rescan" Style="{StaticResource Style.Button.Secondary}" Command="{Binding RescanGamesCommand}"/>
                </Grid>

                <!-- Games ListBox -->
                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2,0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" 
                                                CornerRadius="8" Padding="12,10" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.CardHover}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Highlight}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E2436"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Blue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DriveLetter}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                                        <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding LauncherSource}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Storage Type Badge -->
                                <Border Grid.Column="1" Background="{Binding StorageType, Converter={StaticResource StorageBadgeConverter}}" 
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageType}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="{Binding Games.Count, StringFormat='{}{0} games detected'}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Right: Selected Game Details & Acceleration Actions -->
        <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="20">
            <Grid>
                <!-- Empty state when no game selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Visibility="{Binding HasSelectedGame, Converter={StaticResource InvertedBoolToVisConverter}}">
                    <TextBlock Text="Select a game from the library" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Or add an executable using the '+ Add Game' button" FontSize="12.5" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Game Details Panel -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              Visibility="{Binding HasSelectedGame, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <!-- Header with Game Name and Launch Button -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedGame.Name}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="{Binding SelectedGame.StorageType, Converter={StaticResource StorageBadgeConverter}}" 
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedGame.StorageType, StringFormat='{}Target: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedGame.LearningStatusBadge}" FontSize="12" Foreground="{StaticResource Brush.Accent.Blue}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Primary Action Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Prepare Cache" Style="{StaticResource Style.Button.Secondary}" 
                                        Command="{Binding PrepareCacheCommand}" Margin="0,0,8,0"/>
                                <Button Content="▶ Launch Game" Style="{StaticResource Style.Button.Primary}" 
                                        Command="{Binding LaunchGameCommand}" MinWidth="130"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Section (when preloading / copying) -->
                        <Border Background="#1C2130" BorderBrush="{StaticResource Brush.Accent.Blue}" BorderThickness="1" 
                                CornerRadius="8" Padding="14" Margin="0,0,0,16"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding BusyStatus}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Blue}"/>
                                    <Button HorizontalAlignment="Right" Content="Cancel" Style="{StaticResource Style.Button.Danger}" 
                                            Command="{Binding CancelPreparationCommand}" Padding="8,2" FontSize="11"/>
                                </Grid>
                                <ProgressBar Value="{Binding CurrentProgress.PercentComplete}" Maximum="100" Style="{StaticResource Style.ProgressBar.Modern}"/>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{Binding CurrentProgress.SpeedBytesPerSec, Converter={StaticResource SpeedConverter}}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentProgress.EstimatedTimeRemaining, StringFormat='{}ETA: {0:mm\\:ss}'}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Information Cards Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Storage Details Card -->
                            <Border Grid.Column="0" Background="#141722" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="STORAGE &amp; MEDIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Executable Path:" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding SelectedGame.ExecutablePath}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                                    <TextBlock Text="Install Directory:" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding SelectedGame.InstallDirectory}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                                    <TextBlock Text="Install Size on Disk:" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding SelectedGame.TotalInstallSizeBytes, Converter={StaticResource BytesConverter}}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Profile Configuration Card -->
                            <Border Grid.Column="2" Background="#141722" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="CACHE PROFILE SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="SSD Cache Quota:" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedGame.SsdCacheAllocatedBytes, Converter={StaticResource BytesConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="RAM Prefetch Budget:" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedGame.RamBudgetBytes, Converter={StaticResource BytesConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Estimated Hit Rate:" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedGame.EstimatedHitRate, StringFormat='{}{0:0.#}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Blue}"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="HDD Reads Intercepted:" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedGame.TotalHddReadsAvoided, Converter={StaticResource BytesConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Green}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Additional Actions Row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Open Folder" Style="{StaticResource Style.Button.Secondary}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="Clear Game Cache" Style="{StaticResource Style.Button.Secondary}" Command="{Binding ClearCacheCommand}" Margin="0,0,8,0"/>
                            <Button Content="Remove Profile" Style="{StaticResource Style.Button.Danger}" Command="{Binding RemoveGameCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

