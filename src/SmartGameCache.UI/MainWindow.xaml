<Window x:Class="SmartGameCache.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SmartGameCache.UI.Views"
        xmlns:vm="clr-namespace:SmartGameCache.UI.ViewModels"
        xmlns:nav="clr-namespace:SmartGameCache.UI.Services"
        mc:Ignorable="d"
        Title="Smart Game Cache — Intelligent HDD Accelerator" 
        Height="840" Width="1280" MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg.Primary}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Main}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Sidebar}" 
                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Brush.Accent.Blue}" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Smart Game Cache" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                            <TextBlock Text="HDD Accelerator" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Sidebar Navigation Buttons (Single selection, guaranteed non-overlapping) -->
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsDashboardActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsMyGamesActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="MyGames">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="My Games" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsCacheManagerActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="CacheManager">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="Cache Manager" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsAnalyticsActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="Analytics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="Analytics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsHistoryActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="ActivityHistory">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="Activity &amp; History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dedicated Hardware Testing Mode -->
                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsHardwareTestActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="HardwareTest">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="Hardware Test Mode" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsSettingsActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Style.NavButton}" Tag="{Binding IsAboutActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" Margin="0,0,10,0" FontSize="13"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sidebar Bottom Status Footer -->
                <Border Grid.Row="3" Background="#181B26" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="ACCELERATOR ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Text="{Binding DashboardVM.EngineStateText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Blue}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Elevation Warning Banner (Only visible if not running as Administrator) -->
            <Border Grid.Row="0" Background="#261E14" BorderBrush="#854D0E" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding IsElevated, Converter={StaticResource InvertedBoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ " FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Standard User Mode Active — Run as Administrator for low-level Windows Kernel ETW file tracing." 
                                   FontSize="12" Foreground="#FDE047" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🛡 Restart as Admin" Style="{StaticResource Style.Button.Primary}" 
                            Command="{Binding RestartElevatedCommand}" Padding="10,4" FontSize="11.5"/>
                </Grid>
            </Border>

            <!-- Page Views Host (ContentControl with ViewModel-based DataTemplates: Only 1 View in Visual Tree) -->
            <Border Grid.Row="1" Padding="20">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
                            <views:GamesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CacheManagerViewModel}">
                            <views:CacheManagerView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                            <views:AnalyticsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                            <views:HistoryView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:HardwareTestViewModel}">
                            <views:HardwareTestView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                            <views:AboutView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>

            <!-- Global Bottom Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource Brush.Bg.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding GlobalStatus}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DashboardVM.SystemMemorySummary}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,14,0"/>
                        <TextBlock Text=".NET 10 LTS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Blue}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
