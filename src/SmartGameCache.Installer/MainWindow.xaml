<Window x:Class="SmartGameCache.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Game Cache Setup" Height="420" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextLight}"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Smart Game Cache Setup" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
            <TextBlock Text="Intelligent HDD Gaming Accelerator • Version 1.0.0" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderDark}" Margin="0,0,0,16"/>

        <!-- Main Content -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="Select Installation Folder:" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextLight}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInstallPath" Grid.Column="0" Background="{StaticResource CardDark}" Foreground="{StaticResource TextLight}"
                         BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="8,6" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="14,6"
                        Background="#21262D" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                        Click="BtnBrowse_Click" />
            </Grid>

            <CheckBox x:Name="ChkDesktopShortcut" Content="Create a desktop shortcut" IsChecked="True" Foreground="{StaticResource TextLight}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkLaunchAfter" Content="Launch Smart Game Cache after installation completes" IsChecked="True" Foreground="{StaticResource TextLight}" Margin="0,0,0,16"/>

            <!-- Progress & Status -->
            <TextBlock x:Name="TxtStatus" Text="Ready to install" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
            <ProgressBar x:Name="PrgInstall" Height="10" Minimum="0" Maximum="100" Value="0" Background="{StaticResource CardDark}" Foreground="{StaticResource AccentCyan}"/>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Row="3" Height="1" Background="{StaticResource BorderDark}" Margin="0,16,0,16"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="32" Margin="0,0,8,0"
                    Background="#21262D" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnAction" Content="Install" Width="100" Height="32"
                    Background="{StaticResource AccentCyan}" Foreground="#0D1117" FontWeight="SemiBold" BorderThickness="0"
                    Click="BtnAction_Click"/>
        </StackPanel>
    </Grid>
</Window>

